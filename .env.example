# Docker Compose 环境变量模板
# 使用：复制本文件为 .env 并填入真实值，然后 docker compose up -d --build

# MySQL root 密码（必填，务必改强）
MYSQL_ROOT_PASSWORD=请改成强密码

# JWT 密钥（必填，足够长的随机串，可用 openssl rand -hex 32 生成）
JWT_SECRET=请改成长随机串

# ===== LLM 智能体（可选：留空则纯规则 AI，对局永不卡死）=====
# 支持任何 OpenAI 兼容端点：DeepSeek / Qwen / GLM / vLLM / Ollama
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=deepseek-chat
